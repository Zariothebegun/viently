# Copia para .env e preenche. O .env nunca é versionado.
# OpenRouter (https://openrouter.ai/keys)
EXPO_PUBLIC_OPENROUTER_KEY=
# API oficial do Gemini (https://aistudio.google.com/apikey)
EXPO_PUBLIC_GEMINI_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-3-flash-preview
# API local opcional (proxy AI Studio no mesmo PC)
EXPO_PUBLIC_API_BASE=
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_API_MODEL=
